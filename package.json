{
  "name": "net-cmd-register",
  "description": "网络命令注册器，用于测试网口下发不同命令的测试工具。",
  "main": "./main.js",
  "version": "1.1.4",
  "author": "liansixin",
  "license": "MIT",
  "build": {
    "productName": "NetCmdRegister",
    "appId": "com.NetCmdRegister",
    "directories": {
      "output": "app_file"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./main.ico",
      "uninstallerIcon": "./main.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetCmdRegister"
    },
    "win": {
      "icon": "./main.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["ia32", "x64"]
        }
      ]
    },
    "linux": {
      "icon": "./icons", 
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "maintainer": "liansixin <2013182991@qq.com>"
    }
  },
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "lint": "eslint main.js preload.js renderer.js",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "app-builder-lib": "^26.0.12",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "electron-builder-squirrel-windows": "^26.4.0",
    "electron-winstaller": "^5.4.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "^3.8.1"
  }
}
